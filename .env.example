# Copy this file to .env and fill it in. Never commit .env.
# Keep every real value out of this file — it IS committed.

# Week 3 onwards. Use whichever provider you chose; you do not need all of them.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# If you run open models locally with Ollama instead of an API
OLLAMA_BASE_URL=http://localhost:11434

# Week 4, if you store vectors in Postgres (Neon) rather than Chroma
DATABASE_URL=
